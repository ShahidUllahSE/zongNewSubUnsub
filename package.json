{
  "name": "zong-reverse-flow-service",
  "version": "1.0.0",
  "description": "Zong BOSS Reverse Flow Subscription and Unsubscription SOAP Service",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "prisma:studio": "npx prisma studio",
    "db:setup": "ts-node scripts/setup-db.ts",
    "test:integration": "ts-node tests/integration.test.ts"
  },
  "keywords": [
    "zong",
    "soap",
    "reverse-flow",
    "telecom",
    "subscription",
    "unsubscription"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.4.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.0.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "nodemon": "^3.1.9",
    "prisma": "6.4.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
